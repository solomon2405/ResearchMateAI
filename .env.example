# ========================================================
# ResearchMate AI - Environment Configuration Template
# Copy this file to .env and customize the values.
# ========================================================

# Django Core
# In production, set DEBUG=False and generate a strong 50+ character random SECRET_KEY.
SECRET_KEY=django-insecure-researchmate-development-key-change-in-production-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# Production Security & Proxies (Active only when DEBUG=False)
SECURE_SSL_REDIRECT=False
BEHIND_PROXY=False
SECURE_HSTS_SECONDS=31536000

# Database Configuration (Optional PostgreSQL - if not provided, uses local SQLite)
# Example PostgreSQL URL: postgresql://postgres:postgres@localhost:5432/researchmate
DATABASE_URL=

# Document Storage & Limits
MAX_DOCUMENTS_PER_PROJECT=30
MAX_UPLOAD_SIZE_MB=25

# Academic Search (OpenAlex)
# Providing an email adds requests to the OpenAlex polite pool for faster, higher-rate access
OPENALEX_MAILTO=researcher@example.com

# Embeddings & Vector Store
# Local sentence-transformers model (runs locally on CPU/GPU without external API charges)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_BACKEND=faiss

# LLM Answer Generation
# Options: 'mock' (offline test mode), 'ollama' (local LLM), 'gemini', 'openai_compatible', 'groq'
LLM_PROVIDER=mock
LLM_MODEL_NAME=llama3.2
LLM_API_KEY=
LLM_API_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Provider Specific Keys (alternative to LLM_API_KEY)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# RAG Pipeline Parameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_TOKENS=3000

